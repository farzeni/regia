{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "command -v regia >/dev/null 2>&1 && regia hook spawn; exit 0",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "command -v regia >/dev/null 2>&1 && regia hook group; exit 0",
            "timeout": 3
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v regia >/dev/null 2>&1 && regia hook group; exit 0",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
